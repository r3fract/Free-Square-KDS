PRINTER_TCP_PORT=9100
PRINTER_HTTP_PORT=8008
KDS_SERVER_URL=http://localhost:3000
# Only needed if the logs show the wrong/link-local (169.254.x.x) IP being advertised — set
# this to this machine's real LAN IP (the one on the same network as the Square device).
# ADVERTISE_IP=192.168.1.50
# Model name advertised in Star discovery responses (UDP:22222) and mDNS. Defaults to
# "TSP143IIILAN" — the exact name confirmed working with Square's discovery/pairing. Renaming
# is untested and may cause Square to stop showing the device (it may only surface
# certified/known model names rather than treating this as pure display text).
# STAR_MODEL_NAME=TSP143IIILAN
# Path to the tesseract OCR binary (required — real tickets arrive as rasterized bitmaps, not
# plain text). Defaults to the standard Windows install path / "tesseract" on PATH elsewhere.
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
