# Compose-level configuration. Copy to .env and adjust as needed.
# Per-service secrets (Square credentials, etc.) still live in server/.env and
# printer-sim/.env — see those directories' own .env.example files.

POSTGRES_USER=kds
POSTGRES_PASSWORD=kds
POSTGRES_DB=kds
POSTGRES_PORT=5432

SERVER_PORT=3000
FRONTEND_PORT=3001

# Must be reachable from the browser, not a docker-network-internal hostname.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Allowed browser origin(s) for the server's CORS policy. Comma-separated for more than one.
CORS_ORIGIN=http://localhost:3001

# Only used by the optional printer-sim profile.
PRINTER_SIM_KDS_SERVER_URL=http://localhost:3000
